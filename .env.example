# =============================================================================
# NEURA ERP — Instancia monocliente MG GROUP (single_client)
# =============================================================================
# Copiá este archivo a `.env.local` y completá los valores reales.
# NUNCA commitees `.env.local` ni secretos reales (ver .gitignore: `.env*`).
#
# IMPORTANTE: las variables NEXT_PUBLIC_* se inlinean en BUILD-TIME. Para que el
# bundle del browser opere en modo single_client con el schema dedicado, AMBAS
# (NEURA_* server y NEXT_PUBLIC_NEURA_* browser) deben estar disponibles al build.
# Sin las NEXT_PUBLIC_*, el browser cae al sentinel legacy `zentra_erp`.

# --- Modo de instancia (server) ---------------------------------------------
NEURA_INSTANCE_MODE=single_client
NEURA_CLIENT_SCHEMA=mggroup
NEURA_CLIENT_NAME=MG GROUP

# --- Modo de instancia (browser / inlinado en build) ------------------------
NEXT_PUBLIC_NEURA_INSTANCE_MODE=single_client
NEXT_PUBLIC_NEURA_CLIENT_SCHEMA=mggroup
NEXT_PUBLIC_NEURA_CLIENT_NAME=MG GROUP

# --- empresa_id del cliente (PENDIENTE PASO 4/5) ----------------------------
# Aún no existe la empresa MG GROUP en la base. Setear este UUID una vez creada,
# para que jobs como el cron de etiquetas operen sobre la empresa correcta.
# Mientras esté vacío, esos jobs NO procesan nada para MG GROUP (comportamiento seguro).
NEURA_CLIENT_EMPRESA_ID=

# --- Supabase (sin secretos en este archivo de ejemplo) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Jobs / Cron ------------------------------------------------------------
CRON_SECRET=
